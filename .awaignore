# Local build and validation artifacts. Gitignore is intentionally not used as
# awa scan policy, so keep command-generated noise explicit here.
/awa
/site/dist/
*.test
*.out
coverage.txt
.DS_Store

# User-local tool state no command here reads. Left visible, each would be a run input —
# a provider cache refresh or a newly granted agent permission would discard every
# reusable check — and its bytes would be stored in every checkpoint, credentials
# included.
/.wrangler/
/.claude/settings.local.json
/.awa-integrations.local.md
